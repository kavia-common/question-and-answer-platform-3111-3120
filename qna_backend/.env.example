# Environment configuration for QnA Backend (FastAPI)

# General
ENVIRONMENT=development

# Security / JWT
JWT_SECRET_KEY=change-this-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database
# SQLite local file (created in working directory). You can change to Postgres if needed.
# For SQLite via SQLAlchemy 2.0, format can be "sqlite:///./qna.db" or "sqlite+sqlite:///./qna.db"
DATABASE_URL=sqlite+sqlite:///./qna.db

# OpenAI
# Required for AI-generated answers
OPENAI_API_KEY=your-openai-api-key

# CORS
# Comma separated allowed origins for frontend, e.g., http://localhost:4200
CORS_ALLOW_ORIGINS=*
