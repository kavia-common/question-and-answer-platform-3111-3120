# Required environment variables for qna_backend
# NOTE: Do not commit your real secrets. Copy this file to .env and fill in values.

# JWT configuration
JWT_SECRET_KEY=replace-with-a-secure-random-string
JWT_EXPIRE_MINUTES=60

# OpenAI API
OPENAI_API_KEY=sk-...

# Optional CORS customization (comma-separated domains)
# CORS_ALLOW_ORIGINS=https://your-angular-app.example.com
